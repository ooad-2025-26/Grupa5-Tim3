@model Earn_Learn.Models.Termin
@using Earn_Learn.Enums
@{
    ViewData["Title"] = "Unesi mjesto časa";
    var jeOnline = Model.tipInstrukcija == TipInstrukcija.Online;
}

<div class="container mt-5" style="max-width:560px;">

    <a asp-controller="Tutor" asp-action="Obavjestenja"
       style="display:inline-flex; align-items:center; gap:6px; color:#555;
        font-size:0.88rem; text-decoration:none; margin-bottom:20px;">
        ← Nazad na obavještenja
    </a>

    <div style="background:#fff; border-radius:16px; padding:32px;
        box-shadow:0 4px 24px rgba(0,0,0,0.08);">

        <div style="font-size:2rem; margin-bottom:8px;">
            @(jeOnline ? "🔗" : "📍")
        </div>
        <h4 class="fw-bold mb-1">
            @(jeOnline ? "Link za online čas" : "Lokacija časa")
        </h4>
        <p style="color:#888; font-size:0.9rem; margin-bottom:24px;">
            Termin: <strong>@Model.datumIVrijeme.ToString("dd.MM.yyyy. u HH:mm")h</strong>
            &nbsp;·&nbsp; Predmet: <strong>@(ViewBag.Predmet ?? "—")</strong>
        </p>

        @if (!string.IsNullOrEmpty(Model.mjestoCasa))
        {
            <div style="background:#f0fae5; border:1px solid #c3e6a0; border-radius:10px;
                padding:12px 16px; margin-bottom:20px; font-size:0.9rem; color:#3a7d00;">
                ✅ Trenutno uneseno:
                @if (jeOnline && Model.mjestoCasa.StartsWith("http"))
                {
                    <a href="@Model.mjestoCasa" target="_blank" style="color:#3a7d00; word-break:break-all;">
                        @Model.mjestoCasa
                    </a>
                }
                else
                {
                    <strong>@Model.mjestoCasa</strong>
                }
            </div>
        }

        @if (TempData["Uspjeh"] != null)
        {
            <div style="background:#f0fae5; border:1px solid #c3e6a0; border-radius:10px;
                padding:12px 16px; margin-bottom:20px; font-size:0.9rem; color:#3a7d00;">
                ✅ @TempData["Uspjeh"]
            </div>
        }

        <form asp-controller="Tutor" asp-action="UnesMjestoCasa" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="terminId" value="@Model.id" />

            <div class="mb-3">
                <label class="form-label fw-semibold" for="mjestoCasa">
                    @(jeOnline ? "Google Meet / Zoom link" : "Broj sale / adresa")
                </label>
                <input type="text"
                       id="mjestoCasa"
                       name="mjestoCasa"
                       class="form-control"
                       value="@Model.mjestoCasa"
                       placeholder="@(jeOnline ? "https://meet.google.com/..." : "npr. Sala 12, Filozofski fakultet")"
                       required
                       style="border-radius:10px; padding:12px 14px;" />
                <div class="form-text" style="color:#aaa; font-size:0.82rem;">
                    @(jeOnline
                        ? "Student će dobiti notifikaciju s ovim linkom."
                        : "Student će dobiti notifikaciju s ovom lokacijom.")
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold mt-2"
                    style="border-radius:10px; padding:12px;">
                @(jeOnline ? "💾 Pošalji link studentu" : "💾 Pošalji lokaciju studentu")
            </button>
        </form>
    </div>
</div>
