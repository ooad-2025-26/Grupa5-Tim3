@model List<Earn_Learn.Models.Korisnik>
@{
    ViewData["Title"] = "Rezultati pretrage";
}

<div style="max-width:800px; margin:40px auto; padding:0 24px;">
    <h2>Rezultati pretrage</h2>
    @if (!Model.Any())
    {
        <p>Nema pronađenih tutora.</p>
    }
    <div style="display:flex; flex-direction:column; gap:16px;">
        @foreach (var tutor in Model)
        {
            <a href="@Url.Action("Profil", "Tutor", new { id = tutor.Id })"
                   style="background:#1e3a5f; color:white; border-radius:12px; padding:20px 24px; text-decoration:none; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <strong style="font-size:1.1rem;">@tutor.Ime @tutor.Prezime</strong>
                    <div style="color:#7a9cc0; margin-top:4px;">@tutor.CijenaPoSatu KM/čas</div>
                </div>
                <div style="color:#f5c518;">
                    @tutor.ProsjecnaOcjena?.ToString("F1") ★
                </div>
            </a>
        }
    </div>
</div>