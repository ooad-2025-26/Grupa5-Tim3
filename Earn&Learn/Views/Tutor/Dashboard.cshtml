@model Earn_Learn.Models.TutorDashboardViewModel
@{
    ViewData["Title"] = "Tutor Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .tdash-wrapper {
        color: #fff;
        padding-bottom: 60px;
    }

    .tdash-hero {
        background: #0d2d45;
        padding: 70px 20px 80px;
        text-align: center;
    }

        .tdash-hero h1 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .tdash-hero h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #a0b8c8;
        }

            .tdash-hero h2 span {
                color: #5bc400;
            }

    .tdash-stats {
        background: #0d2d45;
        display: flex;
        justify-content: center;
        gap: 80px;
        padding: 40px 20px 60px;
        flex-wrap: wrap;
    }

    .tdash-stat {
        text-align: center;
    }

        .tdash-stat .broj {
            font-size: 3rem;
            font-weight: 800;
            color: #fff;
        }

        .tdash-stat .label {
            font-size: .95rem;
            color: #a0b8c8;
            margin-top: 4px;
        }

    .tdash-termini {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .tdash-termini-header {
        background: #e8f5e0;
        color: #0d2d45;
        padding: 16px 24px;
        border-radius: 10px 10px 0 0;
        font-size: 1.2rem;
        font-weight: 800;
    }

    .tdash-table-head {
        display: grid;
        grid-template-columns: 2fr 1.6fr 1.8fr 0.8fr 1.1fr 90px;
        padding: 10px 24px;
        background: #f7f7f7;
        border-bottom: 2px solid #e8f5e0;
        font-size: .75rem;
        font-weight: 700;
        color: #5bc400;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .tdash-termin-row {
        display: grid;
        grid-template-columns: 2fr 1.6fr 1.8fr 0.8fr 1.1fr 90px;
        align-items: center;
        padding: 15px 24px;
        border-bottom: 1px solid #f0f0f0;
        background: #fff;
        color: #0d2d45;
        transition: background .15s;
    }

        .tdash-termin-row:hover {
            background: #fafffe;
        }

        .tdash-termin-row:last-child {
            border-bottom: none;
            border-radius: 0 0 10px 10px;
        }

    .tdash-predmet {
        font-weight: 700;
        font-size: .95rem;
        color: #0d2d45;
    }

    .tdash-student {
        font-size: .88rem;
        color: #444;
    }

        .tdash-student.slobodan {
            font-size: .85rem;
            color: #bbb;
            font-style: italic;
        }

    .tdash-datum {
        font-size: .87rem;
        color: #555;
    }

    .tdash-tip {
        font-size: .85rem;
        color: #666;
    }

    .badge {
        display: inline-block;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .badge-rezervisan {
        background: #fff3e0;
        color: #e65c00;
    }

    .badge-slobodan {
        background: #e8f5e0;
        color: #2e7d00;
    }

    .btn-otkai {
        background: #f0f0f0;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: .80rem;
        font-weight: 600;
        cursor: pointer;
        color: #555;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .2s, border-color .2s, color .2s;
        white-space: nowrap;
    }

        .btn-otkai:hover {
            background: #ffe0e0;
            border-color: #f88;
            color: #c00;
        }

    .no-termini {
        color: #999;
        padding: 28px 24px;
        background: #fff;
        border-radius: 0 0 10px 10px;
        font-size: .95rem;
    }

    .alert-success {
        max-width: 960px;
        margin: 20px auto 0;
        padding: 13px 22px;
        background: #e8f5e0;
        color: #2e7d00;
        border-radius: 8px;
        font-weight: 600;
        font-size: .93rem;
    }

    .alert-error {
        max-width: 960px;
        margin: 20px auto 0;
        padding: 13px 22px;
        background: #fff0f0;
        color: #c00;
        border-radius: 8px;
        font-weight: 600;
        font-size: .93rem;
    }
</style>

<div class="tdash-wrapper">

    <!-- HERO -->
    <div class="tdash-hero">
        <h1>Zdravo, @Model.Ime!</h1>
        <h2>Tvoja zarada ovog mjeseca: <span>@Model.Balans.ToString("0") KM</span></h2>
    </div>

    <!-- STATISTIKE -->
    <div class="tdash-stats">
        <div class="tdash-stat">
            <div class="broj">@Model.BrojCasova</div>
            <div class="label">Ukupno časova</div>
        </div>
        <div class="tdash-stat">
            <div class="broj">@Model.ProsjecnaOcjena.ToString("0.0")★</div>
            <div class="label">Prosječna ocjena</div>
        </div>
        <div class="tdash-stat">
            <div class="broj">@Model.Balans.ToString("0") KM</div>
            <div class="label">Dostupan balans</div>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Uspjeh"] != null)
    {
        <div class="alert-success">✓ @TempData["Uspjeh"]</div>
    }
    @if (TempData["Greska"] != null)
    {
        <div class="alert-error">✗ @TempData["Greska"]</div>
    }

    <!-- NADOLAZEĆI TERMINI -->
    <div class="tdash-termini" style="margin-top: 40px;">
        <div class="tdash-termini-header">Nadolazeći časovi</div>

        @if (Model.NadolazaciTermini.Any())
        {
            <div class="tdash-table-head">
                <span>Predmet</span>
                <span>Student</span>
                <span>Datum i vrijeme</span>
                <span>Tip</span>
                <span>Status</span>
                <span></span>
            </div>

            @foreach (var item in Model.NadolazaciTermini)
            {
                var t = item.Termin;
                var tipLabel = t.tipInstrukcija.ToString() == "Online" ? "Online" : "Uživo";
                var statusLabel = t.status.ToString() == "Rezervisan" ? "Rezervisan" : "Slobodan";
                var badgeClass = statusLabel == "Rezervisan" ? "badge-rezervisan" : "badge-slobodan";

                <div class="tdash-termin-row">

                    <span class="tdash-predmet">@(item.ImePredmeta ?? "—")</span>

                    @if (!string.IsNullOrEmpty(item.ImeStudenta))
                    {
                        <span class="tdash-student">@item.ImeStudenta</span>
                    }
                    else
                    {
                        <span class="tdash-student slobodan">Slobodan termin</span>
                    }

                    <span class="tdash-datum">@t.datumIVrijeme.ToString("dd. MMM yyyy. 'u' HH:mm")</span>
                    <span class="tdash-tip">@tipLabel</span>
                    <span><span class="badge @badgeClass">@statusLabel</span></span>

                    <form method="post" asp-action="OtkaziTermin" asp-controller="Tutor"
                          onsubmit="return confirm('Sigurno želiš otkazati ovaj termin?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="terminId" value="@t.id" />
                        <button type="submit" class="btn-otkai">🗑 otkaži</button>
                    </form>

                </div>
            }
        }
        else
        {
            <div class="no-termini">Nemaš nadolazećih časova.</div>
        }
    </div>

</div>
