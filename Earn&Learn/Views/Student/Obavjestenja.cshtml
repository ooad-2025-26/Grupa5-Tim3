@model List<Earn_Learn.Models.Obavjestenje>
@{
    ViewData["Title"] = "Obavještenja";
}

<div style="max-width:700px; margin: 50px auto; padding: 0 20px;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h2 style="font-weight:800; color:#0d2d45; margin:0;">🔔 Sva obavještenja</h2>
        @if (Model.Any())
        {
            <span style="font-size:13px; color:#888;">Ukupno: @Model.Count</span>
        }
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:80px 20px; color:#bbb;">
            <div style="font-size:48px; margin-bottom:16px;">📭</div>
            <div style="font-size:16px; font-weight:600;">Nemate obavještenja</div>
        </div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var n in Model)
            {
                <div style="background:@(n.procitano ? "#fff" : "#f0fbe6"); border:1px solid @(n.procitano ? "#eee" : "#c8f09a"); border-left:4px solid @(n.procitano ? "#ddd" : "#5bc400"); border-radius:10px; padding:16px 20px;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                        <div>
                            <div style="font-weight:@(n.procitano ? "600" : "800"); font-size:15px; color:#0d2d45; margin-bottom:6px;">
                                @n.naslov
                                @if (!n.procitano)
                                {
                                    <span style="background:#5bc400; color:white; font-size:10px; padding:2px 8px; border-radius:8px; margin-left:8px; vertical-align:middle; font-weight:700;">NOVO</span>
                                }
                            </div>
                            <div style="font-size:14px; color:#555; line-height:1.5;">@n.sadrzaj</div>
                        </div>
                    </div>
                    <div style="font-size:12px; color:#bbb; margin-top:10px;">
                        @n.datumSlanja.ToLocalTime().ToString("dd.MM.yyyy. u HH:mm")
                    </div>
                </div>
            }
        </div>
    }

    <div style="margin-top:30px;">
        <a asp-controller="Student" asp-action="Dashboard"
               style="color:#0d2d45; font-weight:700; text-decoration:none; font-size:14px;">
            ← Nazad na Dashboard
        </a>
    </div>
</div>