@model Earn_Learn.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dash-wrapper {
        background: #0d2d45;
        min-height: 100vh;
        color: #fff;
        padding-bottom: 80px;
        margin: -20px;
    }

    .dash-hero {
        background: #0d2d45;
        padding: 70px 20px 50px;
        text-align: center;
    }

        .dash-hero h1 {
            font-size: 2.4rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 28px;
        }

    .search-wrapper-container {
        position: relative;
        max-width: 560px;
        margin: 0 auto;
    }

    .dash-search {
        display: flex;
        align-items: center;
        background: #fff;
        border-radius: 30px;
        padding: 13px 24px;
        gap: 12px;
    }

        .dash-search i {
            color: #0d2d45;
            font-size: 1.15rem;
        }

        .dash-search input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 1rem;
            color: #555;
            background: transparent;
        }

        .dash-search button {
            border: none;
            background: transparent;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
        }

    .search-results-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        z-index: 1000;
        margin-top: 10px;
        max-height: 420px;
        overflow-y: auto;
        display: none;
        padding: 8px;
    }

    .search-tutor-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.2s, transform 0.15s;
        border-radius: 12px;
    }

        .search-tutor-card:last-child {
            border-bottom: none;
        }

        .search-tutor-card:hover {
            background: #f7f9fb;
        }

    .tutor-info-box {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .tutor-info-box h4 {
            margin: 0;
            font-size: 1.05rem;
            color: #0d2d45;
            font-weight: 800;
        }

        .tutor-info-box p {
            margin: 0;
            font-size: 0.88rem;
            color: #666;
            line-height: 1.4;
        }

    .tutor-info-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-top: 2px;
    }

    .search-rating {
        color: #ffc107;
    }

    .search-price {
        color: #2e7d00;
        background: #e8f5e0;
        padding: 2px 8px;
        border-radius: 6px;
    }

    .btn-zakazi-search {
        background: #5bc400;
        color: #fff !important;
        border: none;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.88rem;
        font-weight: 800;
        text-decoration: none !important;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .btn-zakazi-search:hover {
            background: #4ab000;
        }

    .search-no-results {
        padding: 20px;
        text-align: center;
        color: #888;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .dash-sessions {
        max-width: 780px;
        margin: 50px auto 0;
        padding: 0 24px;
    }

        .dash-sessions h2 {
            font-size: .95rem;
            font-weight: 600;
            color: #a0b8c8;
            margin-bottom: 16px;
            text-transform: none;
        }

    .termin-card {
        background: #1a3a55;
        border-radius: 10px;
        padding: 18px 26px;
        margin-bottom: 12px;
        font-weight: 700;
        font-size: .9rem;
        letter-spacing: .4px;
        color: #fff;
        text-transform: uppercase;
    }

    .no-termini {
        color: #a0b8c8;
        font-size: .95rem;
        padding: 20px 0;
    }

        .no-termini a {
            color: #5bc400;
            text-decoration: none;
            cursor: pointer;
            font-weight: bold;
        }

            .no-termini a:hover {
                text-decoration: underline;
            }

    .dash-spotlight {
        max-width: 780px;
        margin: 80px auto 0;
        padding: 0 24px;
        text-align: center;
    }

        .dash-spotlight h2 {
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: 4px;
            color: #fff;
            margin-bottom: 8px;
        }

        .dash-spotlight .subtitle {
            color: #a0b8c8;
            font-size: 1rem;
            margin-bottom: 34px;
        }

    .tutor-grid {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .tutor-card {
        background: #1a3a55;
        border-radius: 14px;
        padding: 34px 20px 24px;
        width: 185px;
        text-align: center;
        transition: transform .15s;
        cursor: pointer;
    }

        .tutor-card:hover {
            transform: translateY(-4px);
        }

        .tutor-card i {
            font-size: 3.4rem;
            color: #a0b8c8;
            display: block;
            margin-bottom: 14px;
        }

        .tutor-card .tutor-name {
            font-size: .88rem;
            font-weight: 700;
            color: #fff;
            display: block;
        }

        .tutor-card .tutor-ocjena {
            font-size: .8rem;
            color: #5bc400;
            margin-top: 4px;
            display: block;
        }
</style>

<div class="dash-wrapper">

    <div class="dash-hero">
        <h1>Zdravo, @Model.Ime!</h1>

        <div class="search-wrapper-container">
            <div class="dash-search">
                <i class="bi bi-search"></i>
                <input type="text" id="studentSearchInput" placeholder="Pretraži tutore ili predmete npr. Tehnike programiranja" autocomplete="off" />
                <button type="button" id="btnSearchSubmit">
                    <i class="bi bi-arrow-right" style="color:#0d2d45;"></i>
                </button>
            </div>

            <div id="searchResultsDropdown" class="search-results-dropdown"></div>
        </div>
    </div>

    <div class="dash-sessions">
        <h2>Tvoje nadolazeće tutoring sesije</h2>

        @if (Model.NadolazaciTermini.Any())
        {
            @foreach (var st in Model.NadolazaciTermini)
            {
                <div class="termin-card">
                    @st.Tutor.Ime.ToUpper() @st.Tutor.Prezime.ToUpper() —
                    @st.Termin.datumIVrijeme.ToString("dd.MM.yyyy. HH:mm")
                    @if (st.Predmet != null)
                    {
                        <span style="color:#a0b8c8; font-weight:400; margin-left:8px;">| @st.Predmet.naziv</span>
                    }
                    <span style="color:#5bc400; font-weight:400; margin-left:8px;">| @st.Termin.cijena.ToString("0.00") KM</span>
                </div>
            }
        }
        else
        {
            <p class="no-termini">
                Nemaš nadolazećih termina.
                <a id="linkPronadjiTutora">Pronađi tutora!</a>
            </p>
        }
    </div>

    <div class="dash-spotlight">
        <h2>TUTOR SPOTLIGHT</h2>
        <p class="subtitle">Najbolje ocijenjeni tutori</p>

        <div class="tutor-grid">
            @foreach (var t in Model.TopTutori)
            {
                <a asp-controller="Tutor" asp-action="Profil" asp-route-id="@t.Id" style="text-decoration:none;">
                    <div class="tutor-card">
                        <i class="bi bi-person-circle"></i>
                        <span class="tutor-name">@t.Ime @t.Prezime</span>
                        @if (t.ProsjecnaOcjena.HasValue && t.ProsjecnaOcjena > 0)
                        {
                            <span class="tutor-ocjena">★ @t.ProsjecnaOcjena.Value.ToString("0.0")</span>
                        }
                    </div>
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            var searchInput = $('#studentSearchInput');
            var resultsDropdown = $('#searchResultsDropdown');

            $('#linkPronadjiTutora').on('click', function (e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $(".dash-hero").offset().top
                }, 400, function () {
                    searchInput.focus();
                });
            });

            searchInput.on('input', function () {
                var query = $(this).val().trim();

                if (query.length === 0) {
                    resultsDropdown.hide().empty();
                    return;
                }

                $.ajax({
                    url: '/Student/PretraziTutore',
                    type: 'GET',
                    data: { query: query },
                    success: function (data) {
                        resultsDropdown.empty();

                        if (data.length === 0) {
                            resultsDropdown.append('<div class="search-no-results">Nema pronađenih tutora ni predmeta.</div>');
                        } else {
                            $.each(data, function (index, tutor) {
                                var predmetiLista = tutor.predmeti.join(', ');
                                var ocjenaTekst = tutor.prosjecnaOcjena > 0 ? '★ ' + tutor.prosjecnaOcjena.toFixed(1) : '★ Nema ocjena';
                                var cijenaTekst = tutor.cijenaPoSatu > 0 ? tutor.cijenaPoSatu.toFixed(2) + ' KM/h' : 'Cijena po dogovoru';

                                var cardHtml = `
                                            <div class="search-tutor-card">
                                                <div class="tutor-info-box">
                                                    <h4>${tutor.ime} ${tutor.prezime}</h4>
                                                    <p><strong>Predmeti:</strong> ${predmetiLista || 'Nema dodijeljenih predmeta'}</p>
                                                    <div class="tutor-info-meta">
                                                        <span class="search-rating">${ocjenaTekst}</span>
                                                        <span class="search-price">${cijenaTekst}</span>
                                                    </div>
                                                </div>
                                                <div>
                                                    <a href="/Tutor/Profil?id=${tutor.id}" class="btn-zakazi-search">Zakaži</a>
                                                </div>
                                            </div>
                                        `;
                                resultsDropdown.append(cardHtml);
                            });
                        }
                        resultsDropdown.show();
                    },
                    error: function () {
                        console.error("Greška prilikom izvršavanja pretrage.");
                    }
                });
            });

            $(document).click(function (e) {
                if (!$(e.target).closest('.search-wrapper-container').length) {
                    resultsDropdown.hide();
                }
            });

            searchInput.click(function () {
                if ($(this).val().trim().length > 0) {
                    resultsDropdown.show();
                }
            });
        });
    </script>
}
