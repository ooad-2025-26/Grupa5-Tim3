@model Earn_Learn.Models.StudentProfilViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<Earn_Learn.Models.Korisnik> UserManager

@{
    ViewData["Title"] = $"{Model.Student.Ime} {Model.Student.Prezime} – Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var trenutniKorisnik = await UserManager.GetUserAsync(User);
    bool jeAdmin = trenutniKorisnik?.Uloga == Earn_Learn.Enums.Uloga.SystemManager;
}

<div style="background:#0d1b2a; color:white; padding:48px 0 32px;">
    <div style="max-width:860px; margin:auto; padding:0 24px;">

        @if (TempData["Uspjeh"] != null)
        {
            <div class="alert alert-success">@TempData["Uspjeh"]</div>
        }

        <div style="display:flex; align-items:center; gap:16px; margin-bottom:8px;">
            <div style="width:72px;height:72px;border-radius:50%;background:#1e3a5f;display:flex;align-items:center;justify-content:center;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="#7a9cc0">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                </svg>
            </div>
            <div>
                <h1 style="margin:0; font-size:2rem; font-weight:700;">@Model.Student.Ime @Model.Student.Prezime</h1>
                <span style="color:#7a9cc0; font-weight:600;">Student</span>
            </div>
        </div>

        <div style="margin-top:20px; display:flex; gap:32px; flex-wrap:wrap;">
            @if (!string.IsNullOrEmpty(Model.Student.Email))
            {
                <div>
                    <div style="color:#7a9cc0; font-size:.8rem; text-transform:uppercase; letter-spacing:1px;">Email</div>
                    <div style="font-weight:600; margin-top:4px;">@Model.Student.Email</div>
                </div>
            }
            @if (Model.Student.BrojIndeksa.HasValue)
            {
                <div>
                    <div style="color:#7a9cc0; font-size:.8rem; text-transform:uppercase; letter-spacing:1px;">Godina studija</div>
                    <div style="font-weight:600; margin-top:4px;">@(Model.Student.BrojIndeksa.Value / 10000). godina</div>
                </div>
            }
            <div>
                <div style="color:#7a9cc0; font-size:.8rem; text-transform:uppercase; letter-spacing:1px;">Registrovan</div>
                <div style="font-weight:600; margin-top:4px;">@Model.Student.DatumRegistracije.ToString("dd.MM.yyyy")</div>
            </div>
        </div>

        @if (Model.Predmeti.Any())
        {
            <div style="margin-top:28px;">
                <h3 style="color:#4caf8a; letter-spacing:2px; font-size:.85rem; text-transform:uppercase; margin-bottom:10px;">Predmeti od interesa</h3>
                @foreach (var p in Model.Predmeti)
                {
                    <p style="margin:4px 0; font-weight:600; letter-spacing:1px; font-size:.9rem; text-transform:uppercase;">@p.naziv</p>
                }
            </div>
        }
    </div>
</div>

@if (jeAdmin)
{
    <div style="background:#ddeeff; padding:32px 0;">
        <div style="max-width:620px; margin:auto; padding:0 24px; text-align:center;">
            <h2 style="font-weight:800; color:#0d2d45; margin-bottom:8px;">Obriši profil</h2>
            <p style="color:#555; margin-bottom:20px;">Trajno ukloni profil ovog studenta iz baze podataka.</p>
            <form asp-controller="SystemManager" asp-action="ObrisiKorisnika" method="post"
                  onsubmit="return confirm('Jesi li siguran da želiš obrisati studenta @Model.Student.Ime @Model.Student.Prezime?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Student.Id" />
                <button type="submit"
                        style="background:#0d2d45; color:#fff; border:none; border-radius:20px; padding:10px 32px; font-weight:800; font-size:.95rem; cursor:pointer;">
                    Obriši
                </button>
            </form>
        </div>
    </div>
}

<div style="background:#f9f9f9; padding:40px 0; border-bottom:1px solid #eee;">
    <div style="max-width:860px; margin:auto; padding:0 24px; display:flex; gap:60px; justify-content:center; flex-wrap:wrap; text-align:center;">
        <div>
            <div style="font-size:2.5rem; font-weight:800; color:#0d2d45;">@Model.Termini.Count</div>
            <div style="color:#888; font-size:.9rem; margin-top:4px;">Ukupno termina</div>
        </div>
        <div>
            <div style="font-size:2.5rem; font-weight:800; color:#0d2d45;">@Model.Recenzije.Count</div>
            <div style="color:#888; font-size:.9rem; margin-top:4px;">Recenzija napisano</div>
        </div>
        <div>
            <div style="font-size:2.5rem; font-weight:800; color:#0d2d45;">@Model.Student.StanjeRacuna.ToString("0") KM</div>
            <div style="color:#888; font-size:.9rem; margin-top:4px;">Stanje računa</div>
        </div>
    </div>
</div>

@if (Model.Recenzije.Any())
{
    <div style="background:#f5f5f5; padding:48px 0;">
        <div style="max-width:800px; margin:auto; padding:0 24px;">
            <h2 style="font-weight:700; text-align:center; margin-bottom:32px;">Prethodne recenzije</h2>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px;">
                @foreach (var rec in Model.Recenzije.Take(6))
                {
                    <div style="background:white; border-radius:12px; padding:20px; text-align:left;">
                        <p style="color:#333; margin-bottom:12px; font-style:italic;">"@rec.Recenzija.komentar"</p>
                        <div style="color:#f5c518; margin-bottom:6px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= rec.Recenzija.ocjena ? "★" : "☆")</span>
                            }
                        </div>
                        <div>
                            <strong>@rec.ImeStudenta</strong>
                            <br /><small style="color:#888;">Tutor</small>
                        </div>
                        <div style="color:#aaa; font-size:.8rem; margin-top:6px;">@rec.Recenzija.datumRecenzije.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.Termini.Any())
{
    <div style="background:white; padding:48px 0;">
        <div style="max-width:800px; margin:auto; padding:0 24px;">
            <h2 style="font-weight:700; margin-bottom:24px;">Historija termina</h2>
            @foreach (var t in Model.Termini.Take(10))
            {
                <div style="padding:12px 0; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center;">
                    <div style="font-weight:600; color:#222;">@t.datumIVrijeme.ToString("dd.MM.yyyy HH:mm")</div>
                    <div style="font-size:.85rem; color:#888;">@t.status</div>
                </div>
            }
        </div>
    </div>
}
