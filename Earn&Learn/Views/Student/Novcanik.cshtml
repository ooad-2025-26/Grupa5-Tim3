@model IEnumerable<Earn_Learn.Models.Transakcija>
@using Earn_Learn.Enums
@{
    ViewData["Title"] = "Novčanik";
    Layout = "~/Views/Shared/_Layout.cshtml";
    double stanje = ViewBag.StanjeRacuna ?? 0.0;
    double ukupno = ViewBag.UkupnoUplaceno ?? 0.0;
}

<style>
    * { font-family: 'Nunito', sans-serif; }

    .nv-hero {
        background: #0d2d45;
        padding: 60px 20px 50px;
        text-align: center;
        color: #fff;
    }
    .nv-hero h1 { font-size: 2rem; font-weight: 800; margin-bottom: 6px; }
    .nv-hero p  { color: #a0b8c8; font-size: 1rem; margin: 0; }

    .nv-stats {
        display: flex;
        justify-content: center;
        gap: 80px;
        padding: 50px 20px 20px;
        text-align: center;
        flex-wrap: wrap;
    }
    .nv-stat .broj  { font-size: 3rem; font-weight: 800; color: #0d2d45; line-height: 1; }
    .nv-stat .label { font-size: .95rem; color: #888; margin-top: 6px; }

    .nv-wrap { max-width: 700px; margin: 0 auto 60px; padding: 0 20px; }

    .nv-uplata-card {
        border: 1.5px solid #eee;
        border-radius: 16px;
        padding: 30px 28px;
        margin-bottom: 32px;
        background: #fff;
        box-shadow: 0 2px 12px rgba(0,0,0,.05);
    }
    .nv-uplata-card h3 { font-size: 1.1rem; font-weight: 800; color: #0d2d45; margin-bottom: 6px; }
    .nv-uplata-card p  { font-size: .88rem; color: #888; margin-bottom: 20px; }

    .iznos-grid {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .btn-iznos {
        background: #f0f7ff;
        color: #0d2d45;
        border: 1.5px solid #c8dff0;
        border-radius: 10px;
        padding: 8px 20px;
        font-weight: 800;
        font-size: .9rem;
        cursor: pointer;
        transition: all .2s;
    }
    .btn-iznos:hover, .btn-iznos.aktivan {
        background: #0d2d45;
        color: #fff;
        border-color: #0d2d45;
    }

    .nv-input-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }
    .nv-input-row input[type=number] {
        flex: 1;
        border: 1.5px solid #ddd;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 1rem;
        font-weight: 700;
        outline: none;
        color: #0d2d45;
    }
    .nv-input-row input:focus { border-color: #5bc400; }

    .btn-uplati {
        background: #5bc400;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-weight: 800;
        font-size: .95rem;
        cursor: pointer;
        transition: opacity .2s;
        white-space: nowrap;
    }
    .btn-uplati:hover { opacity: .85; }

    .nv-section-title {
        font-size: 1rem;
        font-weight: 800;
        color: #0d2d45;
        margin: 32px 0 12px;
        padding-bottom: 6px;
        border-bottom: 2px solid #f0f0f0;
    }

    .nv-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f5f5f5;
        gap: 12px;
    }
    .nv-row:last-child { border-bottom: none; }

    .nv-iznos-plus  { font-size: 1rem; font-weight: 800; color: #2e7d32; }
    .nv-iznos-minus { font-size: 1rem; font-weight: 800; color: #c0392b; }
    .nv-datum { font-size: .82rem; color: #aaa; }
    .nv-tip   { font-size: .82rem; color: #555; flex: 1; }

    .alert-ok  { background: #e8f5e0; color: #2e7d00; border-radius: 10px; padding: 12px 20px; font-weight: 700; margin-bottom: 20px; }
    .alert-err { background: #fff0f0; color: #c00; border-radius: 10px; padding: 12px 20px; font-weight: 700; margin-bottom: 20px; }

    .nv-empty { text-align: center; padding: 30px; color: #aaa; font-size: .95rem; }

    .sim-card {
        background: linear-gradient(135deg, #0d2d45, #1a5276);
        border-radius: 16px;
        padding: 28px 28px 22px;
        color: #fff;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }
    .sim-card::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 160px; height: 160px;
        background: rgba(255,255,255,.06);
        border-radius: 50%;
    }
    .sim-card .chip {
        width: 38px; height: 28px;
        background: linear-gradient(135deg, #f5c518, #e6a800);
        border-radius: 5px;
        margin-bottom: 22px;
    }
    .sim-card .card-broj {
        font-size: 1.1rem;
        letter-spacing: 4px;
        font-weight: 600;
        margin-bottom: 16px;
        color: #c8dff0;
    }
    .sim-card .card-stanje { font-size: 1.8rem; font-weight: 800; }
    .sim-card .card-label  { font-size: .8rem; color: #a0b8c8; margin-top: 2px; }

    .sim-badge {
        position: absolute;
        top: 20px; right: 24px;
        background: rgba(91,196,0,.2);
        color: #5bc400;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: .75rem;
        font-weight: 800;
    }
</style>

<div class="nv-hero">
    <h1>Novčanik</h1>
    <p>Upravljajte sredstvima za plaćanje instrukcija</p>
</div>

<div class="nv-stats">
    <div class="nv-stat">
        <div class="broj" id="stat-stanje">@stanje.ToString("N2") KM</div>
        <div class="label">Trenutno stanje</div>
    </div>
    <div class="nv-stat">
        <div class="broj" id="stat-ukupno">@ukupno.ToString("N2") KM</div>
        <div class="label">Ukupno uplaćeno</div>
    </div>
</div>

<div class="nv-wrap">

    <div class="sim-card">
        <div class="sim-badge">● AKTIVNA</div>
        <div class="chip"></div>
        <div class="card-broj">**** **** **** 4242</div>
        <div class="card-stanje" id="card-stanje">@stanje.ToString("N2") KM</div>
        <div class="card-label">Dostupno stanje</div>
    </div>

    <div class="nv-uplata-card">
        <h3>Uplati sredstva</h3>
        <p>Odaberi iznos ili unesi ručno. Simulacija uplate — novac je dostupan odmah.</p>

        <div class="iznos-grid">
            <button class="btn-iznos" onclick="postaviIznos(10, this)">10 KM</button>
            <button class="btn-iznos" onclick="postaviIznos(20, this)">20 KM</button>
            <button class="btn-iznos" onclick="postaviIznos(50, this)">50 KM</button>
            <button class="btn-iznos" onclick="postaviIznos(100, this)">100 KM</button>
            <button class="btn-iznos" onclick="postaviIznos(200, this)">200 KM</button>
        </div>

        <form id="uplataForm">
            @Html.AntiForgeryToken()
            <div class="nv-input-row">
                <input type="number" id="iznos-input" name="iznos"
                       placeholder="Unesi iznos (KM)"
                       min="1" max="10000" step="0.01" required />
                <button type="submit" class="btn-uplati">Uplati</button>
            </div>
        </form>
    </div>

    <div class="nv-section-title">Historija transakcija</div>

    @if (!Model.Any())
    {
        <div class="nv-empty" id="nv-empty">Nemate još nijednu transakciju.</div>
    }
    else
    {
        @foreach (var t in Model)
        {
            <div class="nv-row">
                <span class="nv-tip">
                    @if (t.iznos > 0)
                    {
                        <span>⬆ Uplata na račun</span>
                    }
                    else
                    {
                        <span>⬇ Plaćanje instrukcija</span>
                    }
                </span>
                <span class="nv-datum">@t.datumUplate.ToString("dd.MM.yyyy HH:mm")</span>
                @if (t.iznos > 0)
                {
                    <span class="nv-iznos-plus">+@t.iznos.ToString("N2") KM</span>
                }
                else
                {
                    <span class="nv-iznos-minus">@t.iznos.ToString("N2") KM</span>
                }
            </div>
        }
    }
</div>

@section Scripts {
<script>
    function postaviIznos(iznos, btn) {
        document.getElementById('iznos-input').value = iznos;
        document.querySelectorAll('.btn-iznos').forEach(b => b.classList.remove('aktivan'));
        btn.classList.add('aktivan');
    }

    document.getElementById('uplataForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const iznos = parseFloat(document.getElementById('iznos-input').value);
        if (!iznos || iznos <= 0 || iznos > 10000) {
            prikaziAlert('Iznos mora biti između 1 i 10,000 KM.', false);
            return;
        }

        const token = document.querySelector('[name="__RequestVerificationToken"]').value;
        const btn = document.querySelector('.btn-uplati');
        btn.disabled = true;
        btn.textContent = '...';

        try {
            const resp = await fetch('/Student/UplatiNovac', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `iznos=${iznos}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });

            const data = await resp.json();

            if (data.success) {
                const novoStanje = parseFloat(data.novoStanje).toFixed(2) + ' KM';

                // Ažuriraj stanje na sva tri mjesta
                document.getElementById('stat-stanje').textContent = novoStanje;
                document.getElementById('card-stanje').textContent = novoStanje;

                // Ažuriraj ukupno uplaćeno
                const trenutnoUkupno = parseFloat(document.getElementById('stat-ukupno').textContent) || 0;
                document.getElementById('stat-ukupno').textContent = (trenutnoUkupno + iznos).toFixed(2) + ' KM';

                // Ukloni "nema transakcija" poruku ako postoji
                const prazno = document.getElementById('nv-empty');
                if (prazno) prazno.remove();

                // Dodaj novi red na vrh historije
                const sectionTitle = document.querySelector('.nv-section-title');
                const sad = new Date();
                const datum = sad.toLocaleDateString('bs-BA', { day: '2-digit', month: '2-digit', year: 'numeric' })
                            + ' ' + sad.toLocaleTimeString('bs-BA', { hour: '2-digit', minute: '2-digit' });
                const noviRed = document.createElement('div');
                noviRed.className = 'nv-row';
                noviRed.innerHTML = `
                    <span class="nv-tip"><span>⬆ Uplata na račun</span></span>
                    <span class="nv-datum">${datum}</span>
                    <span class="nv-iznos-plus">+${iznos.toFixed(2)} KM</span>
                `;
                sectionTitle.insertAdjacentElement('afterend', noviRed);

                document.getElementById('iznos-input').value = '';
                document.querySelectorAll('.btn-iznos').forEach(b => b.classList.remove('aktivan'));
                prikaziAlert(data.poruka, true);
            } else {
                prikaziAlert(data.poruka, false);
            }
        } catch {
            prikaziAlert('Greška pri uplati. Pokušajte ponovo.', false);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Uplati';
        }
    });

    function prikaziAlert(poruka, uspjeh) {
        const stari = document.querySelector('.alert-ok, .alert-err');
        if (stari) stari.remove();
        const div = document.createElement('div');
        div.className = uspjeh ? 'alert-ok' : 'alert-err';
        div.textContent = (uspjeh ? '✓ ' : '✗ ') + poruka;
        document.querySelector('.nv-wrap').prepend(div);
        setTimeout(() => div.remove(), 4000);
    }
</script>
}