@model Earn_Learn.Models.ProfilViewModel
@{
    ViewData["Title"] = "Moj profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profil-wrapper {
        max-width: 800px;
        margin: 60px auto;
        padding: 0 24px;
    }

    .profil-ime {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0d2d45;
        margin-bottom: 4px;
    }

    .profil-uloga {
        font-size: 1rem;
        font-weight: 600;
        color: #888;
        margin-bottom: 16px;
    }

    .profil-grid {
        display: flex;
        gap: 60px;
        flex-wrap: wrap;
    }

    .profil-sekcija h4 {
        font-size: .8rem;
        font-weight: 800;
        color: #5bc400;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .profil-row {
        margin-bottom: 20px;
    }

        .profil-row .label {
            font-size: .9rem;
            font-weight: 700;
            color: #0d2d45;
            margin-bottom: 2px;
        }

        .profil-row .value {
            font-size: .9rem;
            color: #555;
        }

    .predmet-item {
        font-size: .95rem;
        font-weight: 700;
        color: #0d2d45;
        margin-bottom: 14px;
    }

    .profil-footer {
        margin-top: 60px;
        color: #aaa;
        font-size: .82rem;
    }

    /* Cijena edit */
    .cijena-box {
        background: #f7faf4;
        border: 2px solid #e0f0d0;
        border-radius: 12px;
        padding: 20px 24px;
        margin-top: 8px;
    }

    .cijena-prikaz {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cijena-vrijednost {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0d2d45;
    }

    .btn-edit-cijena {
        background: none;
        border: 1px solid #5bc400;
        color: #5bc400;
        border-radius: 8px;
        padding: 5px 14px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-edit-cijena:hover {
            background: #5bc400;
            color: #fff;
        }

    .cijena-forma {
        display: none;
        margin-top: 16px;
        display: none;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .cijena-input {
        padding: 8px 12px;
        border: 2px solid #5bc400;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 700;
        color: #0d2d45;
        outline: none;
        width: 130px;
    }

    .btn-spremi {
        background: #5bc400;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity .2s;
    }

        .btn-spremi:hover {
            opacity: .85;
        }

    .btn-odustani {
        background: none;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: .88rem;
        color: #888;
        cursor: pointer;
    }

        .btn-odustani:hover {
            background: #f5f5f5;
        }

    .alert-success-profil {
        padding: 12px 20px;
        background: #e8f5e0;
        color: #2e7d00;
        border-radius: 8px;
        font-weight: 600;
        font-size: .92rem;
        margin-bottom: 24px;
    }

    .alert-error-profil {
        padding: 12px 20px;
        background: #fff0f0;
        color: #c00;
        border-radius: 8px;
        font-weight: 600;
        font-size: .92rem;
        margin-bottom: 24px;
    }

    /* Postani tutor button */
    .btn-postani-tutor {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #5bc400;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 22px;
        font-size: .92rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
        margin-bottom: 32px;
        text-decoration: none;
    }

        .btn-postani-tutor:hover {
            background: #4aab00;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(91,196,0,.3);
        }

    /* Modal stilovi */
    .tutor-modal .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 60px rgba(0,0,0,.15);
    }

    .tutor-modal .modal-header {
        border-bottom: 2px solid #f0f0f0;
        padding: 24px 28px 16px;
    }

    .tutor-modal .modal-title {
        font-weight: 800;
        color: #0d2d45;
        font-size: 1.2rem;
    }

    .tutor-modal .modal-body {
        padding: 24px 28px;
    }

    .tutor-modal .modal-footer {
        border-top: 2px solid #f0f0f0;
        padding: 16px 28px 24px;
    }

    .predmeti-lista {
        max-height: 280px;
        overflow-y: auto;
        border: 2px solid #e8e8e8;
        border-radius: 10px;
        padding: 12px 16px;
        background: #fafafa;
    }

        .predmeti-lista::-webkit-scrollbar {
            width: 6px;
        }

        .predmeti-lista::-webkit-scrollbar-thumb {
            background: #5bc400;
            border-radius: 3px;
        }

        .predmeti-lista .form-check {
            padding: 6px 0 6px 26px;
            border-bottom: 1px solid #f0f0f0;
        }

            .predmeti-lista .form-check:last-child {
                border-bottom: none;
            }

        .predmeti-lista .form-check-input:checked {
            background-color: #5bc400;
            border-color: #5bc400;
        }

        .predmeti-lista .form-check-label {
            font-size: .9rem;
            font-weight: 600;
            color: #0d2d45;
            cursor: pointer;
        }

    .modal-section-label {
        font-size: .8rem;
        font-weight: 800;
        color: #5bc400;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .prilog-box {
        border: 2px dashed #d0d0d0;
        border-radius: 10px;
        padding: 16px;
        background: #fafafa;
        transition: border-color .2s;
    }

        .prilog-box:hover {
            border-color: #5bc400;
        }

    .btn-potvrdi {
        background: #5bc400;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        font-size: .95rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-potvrdi:hover {
            background: #4aab00;
            transform: translateY(-1px);
        }

    .btn-odustani-modal {
        background: none;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 10px 22px;
        font-size: .9rem;
        font-weight: 600;
        color: #888;
        cursor: pointer;
        transition: all .2s;
    }

        .btn-odustani-modal:hover {
            border-color: #bbb;
            background: #f5f5f5;
        }
</style>

<div class="profil-wrapper">
    <div class="profil-ime">@Model.Ime @Model.Prezime</div>
    <div class="profil-uloga">@Model.Uloga.ToString()</div>

    @* Dugme "Postani tutor" — samo za studente *@
    @if (Model.Uloga == Earn_Learn.Enums.Uloga.Student)
    {
        <button type="button" class="btn-postani-tutor"
                data-bs-toggle="modal" data-bs-target="#postaniTutorModal">
            🎓 Postani tutor
        </button>

        @if (TempData["TutorGreska"] != null)
        {
            <div class="alert-error-profil">✗ @TempData["TutorGreska"]</div>
        }
    }

    @if (TempData["Uspjeh"] != null)
    {
        <div class="alert-success-profil">✓ @TempData["Uspjeh"]</div>
    }
    @if (TempData["Greska"] != null)
    {
        <div class="alert-error-profil">✗ @TempData["Greska"]</div>
    }

    <div class="profil-grid">
        <div class="profil-sekcija">
            <h4>Osnovni podaci</h4>

            @if (Model.Uloga == Earn_Learn.Enums.Uloga.Student && Model.BrojIndeksa.HasValue)
            {
                <div class="profil-row">
                    <div class="label">Godina studija</div>
                    <div class="value">Broj indeksa: @Model.BrojIndeksa</div>
                </div>
            }

            <div class="profil-row">
                <div class="label">Email adresa</div>
                <div class="value">@Model.Email</div>
            </div>

            @if (Model.Uloga == Earn_Learn.Enums.Uloga.Tutor)
            {
                @if (ViewBag.ProsjecnaOcjena != null)
                {
                    <div class="profil-row">
                        <div class="label">Prosječna ocjena</div>
                        <div class="value">⭐ @(((double)ViewBag.ProsjecnaOcjena).ToString("0.0"))</div>
                    </div>
                }

                <!-- CIJENA SA EDIT OPCIJOM -->
                <div class="profil-row">
                    <div class="label">Cijena po satu</div>
                    <div class="cijena-box">
                        <div class="cijena-prikaz">
                            <span class="cijena-vrijednost" id="cijenaVrijednost">@(((double)ViewBag.CijenaPoSatu).ToString("0.00")) KM/h</span>
                            <button class="btn-edit-cijena" onclick="toggleEditCijena()">✏ Uredi</button>
                        </div>

                        <div class="cijena-forma" id="cijenaForma">
                            <form method="post" asp-action="UrediCijenu" asp-controller="Profil" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                                @Html.AntiForgeryToken()
                                <input type="number"
                                       name="cijenaPoSatu"
                                       class="cijena-input"
                                       value="@((double)ViewBag.CijenaPoSatu)"
                                       min="0"
                                       step="0.5"
                                       required />
                                <span style="font-size:.9rem; color:#888;">KM/h</span>
                                <button type="submit" class="btn-spremi">Spremi</button>
                                <button type="button" class="btn-odustani" onclick="toggleEditCijena()">Odustani</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Predmeti != null && Model.Predmeti.Any())
        {
            <div class="profil-sekcija">
                <h4>@(Model.Uloga == Earn_Learn.Enums.Uloga.Tutor ? "Predmeti koje predajem:" : "Predmeti od interesa:")</h4>
                @foreach (var p in Model.Predmeti)
                {
                    <div class="predmet-item"><i class="bi bi-book text-muted me-2"></i>@p</div>
                }
            </div>
        }
    </div>

    <div class="profil-footer">
        &copy; 2026<br />Sva prava zadržana
    </div>
</div>

@* ── MODAL: Postani tutor ── *@
@if (Model.Uloga == Earn_Learn.Enums.Uloga.Student)
{
    <div class="modal fade tutor-modal" id="postaniTutorModal" tabindex="-1"
         aria-labelledby="postaniTutorLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="postaniTutorLabel">🎓 Postani tutor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post"
                      asp-action="PostaniTutor"
                      asp-controller="Profil"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">

                        <div class="modal-section-label">Predmeti koje želim podučavati</div>
                        <div class="predmeti-lista mb-4">
                            @foreach (var predmet in Model.SviPredmeti)
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="odabraniPredmeti"
                                           value="@predmet.id"
                                           id="predmet_@predmet.id" />
                                    <label class="form-check-label" for="predmet_@predmet.id">
                                        @predmet.naziv
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="modal-section-label">Prilog — ocjene iz predmeta</div>
                        <div class="prilog-box">
                            <input type="file"
                                   name="prilogOcjene"
                                   class="form-control border-0 bg-transparent p-0"
                                   accept=".jpg,.jpeg,.png,.pdf" />
                            <small class="text-muted mt-2 d-block">JPG, PNG ili PDF, max 5MB</small>
                        </div>

                    </div>
                    <div class="modal-footer gap-2">
                        <button type="button" class="btn-odustani-modal"
                                data-bs-dismiss="modal">
                            Odustani
                        </button>
                        <button type="submit" class="btn-potvrdi">Potvrdi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    function toggleEditCijena() {
        var forma = document.getElementById('cijenaForma');
        var prikaz = document.querySelector('.cijena-prikaz');
        if (forma.style.display === 'flex') {
            forma.style.display = 'none';
            prikaz.style.display = 'flex';
        } else {
            forma.style.display = 'flex';
            prikaz.style.display = 'none';
            forma.querySelector('input').focus();
        }
    }
</script>
