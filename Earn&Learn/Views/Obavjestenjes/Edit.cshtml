@model Earn_Learn.Models.Obavjestenje

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Obavjestenje</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <div class="form-group">
                <label asp-for="idKorisnika" class="control-label"></label>
                <input asp-for="idKorisnika" class="form-control" />
                <span asp-validation-for="idKorisnika" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="naslov" class="control-label"></label>
                <input asp-for="naslov" class="form-control" />
                <span asp-validation-for="naslov" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="sadrzaj" class="control-label"></label>
                <input asp-for="sadrzaj" class="form-control" />
                <span asp-validation-for="sadrzaj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="datumSlanja" class="control-label"></label>
                <input asp-for="datumSlanja" class="form-control" />
                <span asp-validation-for="datumSlanja" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="procitano" /> @Html.DisplayNameFor(model => model.procitano)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
