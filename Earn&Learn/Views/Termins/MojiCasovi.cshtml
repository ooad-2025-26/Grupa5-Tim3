@model List<Earn_Learn.Models.Termin>
@using Earn_Learn.Enums

@{
    ViewData["Title"] = "Moji časovi";
    var predmeti = ViewBag.Predmeti as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container mt-5">
    <h2 class="fw-bold">Moji časovi</h2>
    <p class="text-muted">Pregled Vaših termina i zakazanih instrukcija od strane studenata</p>

    @if (Model == null || !Model.Any())
    {
        <div class="p-4 bg-light rounded mb-3">
            Trenutno nemate unesenih termina u rasporedu.
        </div>
        <a asp-controller="Termins" asp-action="KreirajTermin" class="btn btn-success mt-2">
            + Kreiraj termin
        </a>
    }
    else
    {
        <div class="mb-3 text-end">
            <a asp-controller="Termins" asp-action="KreirajTermin" class="btn btn-success">
                + Kreiraj termin
            </a>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Datum i vrijeme</th>
                    <th>Predmet</th>
                    <th>Tip</th>
                    <th>Status</th>
                    <th>Cijena (KM/h)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.datumIVrijeme.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @(t.idPredmeta.HasValue && predmeti.ContainsKey(t.idPredmeta.Value)
                                ? predmeti[t.idPredmeta.Value]
                                : "-")
                        </td>
                        <td>@t.tipInstrukcija</td>
                        <td>@t.status</td>
                        <td>@t.cijena</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>