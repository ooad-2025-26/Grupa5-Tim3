@using Earn_Learn.Enums
@{
    ViewData["Title"] = "Kreiraj termin";
    var predmeti = ViewBag.Predmeti as List<Earn_Learn.Models.Predmet>
                   ?? new List<Earn_Learn.Models.Predmet>();
    double cijena = ViewBag.CijenaPoSatu;
}

<div class="container mt-5" style="max-width:600px;">
    <h4 class="fw-bold mb-1">Cijena instrukcija: @cijena KM / h</h4>

    <form asp-controller="Termins" asp-action="KreirajTermin" method="post" class="mt-4">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label class="form-label fw-semibold">Odaberi način izvođenja tutorijala:</label>
            <div class="d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio"
                           name="tipInstrukcija" value="Online"
                           id="tipOnline" checked />
                    <label class="form-check-label" for="tipOnline">Online</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio"
                           name="tipInstrukcija" value="Uzivo"
                           id="tipUzivo" />
                    <label class="form-check-label" for="tipUzivo">Uživo</label>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Odaberi predmet:</label>
            <select name="idPredmeta" class="form-select">
                @foreach (var p in predmeti)
                {
                    <option value="@p.id">@p.naziv</option>
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Datum i vrijeme termina:</label>
            <input type="datetime-local" name="datumIVrijeme"
                   class="form-control" required />
        </div>

        <button type="submit" class="btn btn-success w-100">Potvrdi</button>
    </form>
</div>