@model IEnumerable<Earn_Learn.Models.Termin>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.idStudenta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idTutora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.datumIVrijeme)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tipInstrukcija)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.qrKod)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.idStudenta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idTutora)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.datumIVrijeme)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tipInstrukcija)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.qrKod)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
