@page
@using Earn_Learn.Areas.Identity.Pages.Account
@model LoginModel
@{
    ViewData["Title"] = "Prijava";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* Glavni kontejner i pozadinski gradijent prema slici */
    .login-container {
        background: linear-gradient(180deg, #2bb601 0%, #0d6b52 100%);
        padding: 90px 20px 100px 20px;
        text-align: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Naslovna sekcija na vrhu */
    .login-header-text {
        margin-bottom: 45px;
    }

        /* Gornji naslov je sada CRN */
        .login-header-text h1 {
            color: #000000;
            font-size: 2.1rem;
            font-weight: 800;
            margin-bottom: 14px;
            letter-spacing: -0.5px;
        }

        /* Donji naslov je dosta VEĆI, ŠIRI i ostao je BIJEL */
        .login-header-text p {
            color: #ffffff;
            font-size: 1.8rem; /* Povećano sa 1.2rem */
            font-weight: 700;
            line-height: 1.4;
            max-width: 800px; /* Omogućava tekstu da se više raširi horizontalno */
            margin: 0 auto;
            opacity: 1;
        }

    /* Horizontalna tanka linija ispod zaglavlja */
    .login-divider {
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        max-width: 800px; /* Prošireno da prati širinu donjeg naslova */
        margin: 40px auto;
    }

    /* Centralna bijela kartica */
    .login-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px 35px;
        width: 100%;
        max-width: 430px;
        margin: 0 auto 25px auto;
        box-shadow: none;
        text-align: left;
    }

        .login-card h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #111111;
            margin-top: 0;
            margin-bottom: 35px;
            text-align: center;
            letter-spacing: -0.5px;
        }

    /* Polja za unos */
    .login-field {
        margin-bottom: 22px;
    }

        .login-field label {
            display: block;
            font-size: 0.75rem;
            font-weight: 500;
            color: #888888;
            margin-bottom: 8px;
        }

        .login-field input {
            width: 100%;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            border-radius: 10px;
            padding: 13px 16px;
            font-size: 0.9rem;
            color: #333333;
            font-weight: 500;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .login-field input:focus {
                border-color: #2bb601;
            }

            .login-field input::placeholder {
                color: #b1bbc6;
                font-size: 0.9rem;
                font-weight: 400;
            }

    /* Primarno dugme "Prijavi se" */
    .btn-prijavi {
        width: 100%;
        background: #ffffff;
        border: 1px solid #2bb601;
        color: #2bb601;
        border-radius: 10px;
        padding: 13px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 15px;
        transition: all 0.2s ease-in-out;
    }

        .btn-prijavi:hover {
            background: #2bb601;
            color: #ffffff;
        }

    /* Linkovi i dugmad ispod kartice */
    .forgot-password-text {
        display: block;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 15px;
        opacity: 0.9;
        transition: opacity 0.2s;
    }

        .forgot-password-text:hover {
            opacity: 1;
            text-decoration: none;
        }

    .btn-resetuj {
        display: inline-block;
        background: #000000;
        color: #ffffff;
        border: none;
        border-radius: 25px;
        padding: 12px 45px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-resetuj:hover {
            background: #1a1a1a;
        }

    /* Validacija */
    .text-danger {
        font-size: 0.8rem;
        color: #dc2626;
        margin-top: 5px;
        display: block;
    }

    .validation-summary-errors ul {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
        font-size: 0.85rem;
        list-style: none;
    }
</style>

<div class="login-container">
    
    <div class="login-header-text">
        <h1>Prijavite se na Earn&amp;Learn</h1>
        <p>Nastavite učiti i zarađivati sa svojim kolegama</p>
    </div>

    <hr class="login-divider" />

    <div class="login-card">
        <h2>Podaci za prijavu</h2>

        <form id="loginForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="login-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" placeholder="tvojmail@etf.unsa.ba" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="login-field">
                <label asp-for="Input.Password">Šifra</label>
                <input asp-for="Input.Password" type="password" placeholder="Upiši šifru" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-prijavi">Prijavi se</button>
        </form>
    </div>

    <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="forgot-password-text">
        Zaboravljena šifra?
    </a>

    <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="btn-resetuj">
        Resetuj šifru
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}