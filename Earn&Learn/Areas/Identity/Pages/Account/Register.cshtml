@page
@using Earn_Learn.Areas.Identity.Pages.Account
@model RegisterModel
@{
    ViewData["Title"] = "Registracija";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .reg-hero {
        background: #5bc400;
        padding: 60px 20px 40px;
        text-align: center;
        margin: 0 30px 0;
        border-radius: 0 0 18px 18px;
    }

        .reg-hero h1 {
            color: #fff;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .reg-hero p {
            color: rgba(255,255,255,0.88);
            font-size: .97rem;
            max-width: 520px;
            margin: 0 auto 36px;
            line-height: 1.6;
        }

    .reg-role-row {
        display: flex;
        justify-content: center;
        gap: 60px;
        flex-wrap: wrap;
    }

    .reg-role-item {
        text-align: center;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
    }

        .reg-role-item .role-icon {
            font-size: 2.2rem;
            margin-bottom: 8px;
            display: block;
        }

    /* FORM SECTION */
    .reg-form-section {
        background: linear-gradient(180deg, #5bc400 0%, #2d7a00 100%);
        margin: 0 30px 60px;
        border-radius: 0 0 18px 18px;
        padding: 40px 20px 60px;
        display: flex;
        justify-content: center;
    }

    .reg-card {
        background: #fff;
        border-radius: 18px;
        padding: 36px 40px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    }

        .reg-card h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #0d2d45;
            margin-bottom: 24px;
            text-align: center;
        }

    .reg-field {
        margin-bottom: 16px;
    }

        .reg-field label {
            display: block;
            font-size: .82rem;
            font-weight: 700;
            color: #555;
            margin-bottom: 5px;
        }

        .reg-field input[type="text"],
        .reg-field input[type="email"],
        .reg-field input[type="password"],
        .reg-field select {
            width: 100%;
            border: none;
            background: #f0f0f0;
            border-radius: 8px;
            padding: 11px 14px;
            font-size: .95rem;
            font-family: 'Nunito', sans-serif;
            color: #333;
            outline: none;
            box-sizing: border-box;
            transition: background .2s;
        }

            .reg-field input:focus,
            .reg-field select:focus {
                background: #e5e5e5;
            }

        .reg-field input::placeholder {
            color: #aaa;
        }

    .reg-check {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        cursor: pointer;
    }

        .reg-check input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #5bc400;
            cursor: pointer;
        }

        .reg-check span {
            font-size: .93rem;
            font-weight: 600;
            color: #333;
        }

    #tutor-fields {
        display: none;
    }

    .btn-registruj {
        width: 100%;
        background: #fff;
        border: 2px solid #5bc400;
        color: #5bc400;
        border-radius: 30px;
        padding: 12px;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        margin-top: 8px;
        font-family: 'Nunito', sans-serif;
        transition: background .2s, color .2s;
    }

        .btn-registruj:hover {
            background: #5bc400;
            color: #fff;
        }

    .reg-login-hint {
        text-align: center;
        padding: 30px 20px 10px;
        color: #666;
        font-size: .95rem;
    }

        .reg-login-hint a {
            color: #5bc400;
            font-weight: 700;
            text-decoration: none;
        }

    .text-danger {
        font-size: .8rem;
        color: #e53935;
        margin-top: 3px;
        display: block;
    }

    .validation-summary-errors ul {
        background: #fff3f3;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
        color: #e53935;
        font-size: .85rem;
    }
</style>

<!-- HERO -->
<section class="reg-hero">
    <h1>Pridruži se Earn&amp;Learn zajednici</h1>
    <p>
        Odaberi svoju ulogu ispod kako bi nastavio/la. Studentima nudimo brzu pomoć i povezivanje
        s tutorima. Ako želiš podučavati i zaraditi putem platforme, odaberi Tutor.
    </p>
    <div class="reg-role-row">
        <div class="reg-role-item">
            <span class="role-icon"><i class="bi bi-coin"></i></span>
            Registruj se kao<br>Tutor
        </div>
        <div class="reg-role-item">
            <span class="role-icon"><i class="bi bi-journal-bookmark"></i></span>
            Registruj se kao<br>Student
        </div>
    </div>
</section>

<!-- FORM -->
<section class="reg-form-section">
    <div class="reg-card">
        <h2>Registracijski podaci</h2>

        <form id="registerForm" method="post" action="/Account/RegisterIdentity">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="reg-field">
                <label asp-for="Input.Ime">Ime</label>
                <input asp-for="Input.Ime" type="text" placeholder="Ime" />
                <span asp-validation-for="Input.Ime" class="text-danger"></span>
            </div>

            <div class="reg-field">
                <label asp-for="Input.Prezime">Prezime</label>
                <input asp-for="Input.Prezime" type="text" placeholder="Prezime" />
                <span asp-validation-for="Input.Prezime" class="text-danger"></span>
            </div>

            <div class="reg-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" placeholder="tvojmail@etf.unsa.ba" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="reg-field">
                <label asp-for="Input.Password">Šifra</label>
                <input asp-for="Input.Password" type="password" placeholder="Najmanje 6 karaktera" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="reg-field">
                <label asp-for="Input.ConfirmPassword">Potvrda</label>
                <input asp-for="Input.ConfirmPassword" type="password" placeholder="Ponovo upiši šifru" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="reg-field">
                <label>Uloga</label>
                <select name="uloga" style="width:100%; padding:11px 14px; background:#f0f0f0; border:none; border-radius:8px; font-size:.95rem;">
                    <option value="2">Student</option>
                    <option value="1">Tutor</option>
                </select>
            </div>

            <label class="reg-check">
                <input type="checkbox" id="zelimTutor" asp-for="Input.ZelimBitiTutor" />
                <span>Želim biti tutor</span>
            </label>

            <div id="tutor-fields">
                <div class="reg-field">
                    <label asp-for="Input.OdabraniPredmeti">Predmeti koje želim podučavati</label>
                    <div style="max-height: 200px; overflow-y: auto; background: #f0f0f0; border-radius: 8px; padding: 10px;">
                        @foreach (var predmet in Model.PredmetiSelectList)
                        {
                            <label style="display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: .9rem; cursor: pointer;">
                                <input type="checkbox" name="Input.OdabraniPredmeti" value="@predmet.Value"
                                       style="accent-color: #5bc400; width: 16px; height: 16px;" />
                                @predmet.Text
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Input.OdabraniPredmeti" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn-registruj">Registruj se</button>
        </form>
    </div>
</section>

<!-- LOGIN HINT -->
<div class="reg-login-hint">
    <strong>Već imate nalog? Prijavite se</strong><br>
    <a asp-area="Identity" asp-page="/Account/Login">Kliknite ovdje za prijavu u postojeći račun.</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('zelimTutor').addEventListener('change', function () {
            document.getElementById('tutor-fields').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
