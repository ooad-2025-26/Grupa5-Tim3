@page
@using Earn_Learn.Areas.Identity.Pages.Account
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Email poslan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .login-container {
        background: linear-gradient(180deg, #2bb601 0%, #0d6b52 100%);
        padding: 90px 20px 100px 20px;
        text-align: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .login-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 50px 35px;
        width: 100%;
        max-width: 430px;
        margin: 0 auto 25px auto;
        text-align: center;
    }

        .login-card h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #111111;
            margin-bottom: 15px;
        }

        .login-card p {
            color: #666;
            font-size: 0.95rem;
            line-height: 1.6;
        }

    .btn-nazad {
        display: inline-block;
        background: #000000;
        color: #ffffff;
        border: none;
        border-radius: 25px;
        padding: 12px 45px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
        margin-top: 10px;
    }

        .btn-nazad:hover {
            background: #1a1a1a;
            color: #ffffff;
        }
</style>

<div class="login-container">
    <div class="login-card">
        <h2>✅ Email je poslan!</h2>
        <p>Provjeri svoju email poštu i klikni na link za resetovanje šifre.</p>
    </div>

    <a asp-area="Identity" asp-page="/Account/Login" class="btn-nazad">
        Nazad na prijavu
    </a>
</div>