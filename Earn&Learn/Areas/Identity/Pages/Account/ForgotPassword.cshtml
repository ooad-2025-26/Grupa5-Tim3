@page
@using Earn_Learn.Areas.Identity.Pages.Account
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Resetuj šifru";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .login-container {
        background: linear-gradient(180deg, #2bb601 0%, #0d6b52 100%);
        padding: 90px 20px 100px 20px;
        text-align: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .login-header-text {
        margin-bottom: 45px;
    }

        .login-header-text h1 {
            color: #000000;
            font-size: 2.1rem;
            font-weight: 800;
            margin-bottom: 14px;
            letter-spacing: -0.5px;
        }

        .login-header-text p {
            color: #ffffff;
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1.4;
            max-width: 800px;
            margin: 0 auto;
        }

    .login-divider {
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        max-width: 800px;
        margin: 40px auto;
    }

    .login-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px 35px;
        width: 100%;
        max-width: 430px;
        margin: 0 auto 25px auto;
        text-align: left;
    }

        .login-card h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #111111;
            margin-top: 0;
            margin-bottom: 10px;
            text-align: center;
            letter-spacing: -0.5px;
        }

        .login-card .card-subtitle {
            text-align: center;
            color: #888888;
            font-size: 0.9rem;
            margin-bottom: 30px;
        }

    .login-field {
        margin-bottom: 22px;
    }

        .login-field label {
            display: block;
            font-size: 0.75rem;
            font-weight: 500;
            color: #888888;
            margin-bottom: 8px;
        }

        .login-field input {
            width: 100%;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            border-radius: 10px;
            padding: 13px 16px;
            font-size: 0.9rem;
            color: #333333;
            font-weight: 500;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .login-field input:focus {
                border-color: #2bb601;
            }

            .login-field input::placeholder {
                color: #b1bbc6;
                font-size: 0.9rem;
                font-weight: 400;
            }

    .btn-prijavi {
        width: 100%;
        background: #ffffff;
        border: 1px solid #2bb601;
        color: #2bb601;
        border-radius: 10px;
        padding: 13px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 15px;
        transition: all 0.2s ease-in-out;
    }

        .btn-prijavi:hover {
            background: #2bb601;
            color: #ffffff;
        }

    .btn-nazad {
        display: inline-block;
        background: #000000;
        color: #ffffff;
        border: none;
        border-radius: 25px;
        padding: 12px 45px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s;
        margin-top: 10px;
    }

        .btn-nazad:hover {
            background: #1a1a1a;
            color: #ffffff;
        }

    .text-danger {
        font-size: 0.8rem;
        color: #dc2626;
        margin-top: 5px;
        display: block;
    }

    .validation-summary-errors ul {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
        font-size: 0.85rem;
        list-style: none;
    }
</style>

<div class="login-container">

    <div class="login-header-text">
        <h1>Resetuj svoju šifru</h1>
        <p>Upiši email i poslaćemo ti link za reset</p>
    </div>

    <hr class="login-divider" />

    <div class="login-card">
        <h2>Zaboravljena šifra?</h2>
        <p class="card-subtitle">Upiši email vezan za tvoj nalog</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="login-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" placeholder="tvojmail@etf.unsa.ba" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-prijavi">Pošalji reset link</button>
        </form>
    </div>

    <a asp-area="Identity" asp-page="/Account/Login" class="btn-nazad">
        Nazad na prijavu
    </a>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}